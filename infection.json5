{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src/Git/Parser", "src/Git/Remote"]
    },
    "phpUnit": {
        "configDir": "."
    },
    "logs": {
        "text": ".infection/infection.log"
    },
    "mutators": {
        "@default": true
    },
    "minMsi": 100,
    "minCoveredMsi": 100
}
