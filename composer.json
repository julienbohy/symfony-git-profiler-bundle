{
    "name": "julienbohy/git-profiler-bundle",
    "description": "Displays Git information (branch, commit and working state) in the Symfony Web Profiler.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "bundle", "profiler", "git", "data-collector"],
    "homepage": "https://github.com/julienbohy/symfony-git-profiler-bundle",
    "support": {
        "issues": "https://github.com/julienbohy/symfony-git-profiler-bundle/issues",
        "source": "https://github.com/julienbohy/symfony-git-profiler-bundle"
    },
    "authors": [
        {
            "name": "Julien Bohy"
        }
    ],
    "require": {
        "php": ">=8.3",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/config": "^6.4 || ^7.4 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.0",
        "symfony/process": "^6.4 || ^7.4 || ^8.0",
        "symfony/service-contracts": "^2.5 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.35.9",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpunit/phpunit": "^11.5",
        "symfony/twig-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "JulienBohy\\GitProfilerBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JulienBohy\\GitProfilerBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "infection": "infection --threads=max --show-mutations --no-progress"
    }
}
